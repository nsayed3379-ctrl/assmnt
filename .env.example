# Supabase project settings (Project Settings -> API) - use a DEDICATED
# Supabase project for this platform, not one shared with another app.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key - server-only, NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage bucket used for candidate file uploads (created by supabase/schema.sql)
SUPABASE_SUBMISSIONS_BUCKET=submissions

# Resend (resend.com) - transactional email for invitations/resend-code
RESEND_API_KEY=re_your_api_key
# Once your domain is verified in Resend, switch this to your own domain:
EMAIL_FROM="Vecosoft Careers <onboarding@resend.dev>"

# Public URL this app is deployed at (used inside email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Used to sign admin and candidate session cookies. Any long random string,
# e.g. generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=change-this-to-a-long-random-string

# Used to let admins view a candidate's current access code from the
# dashboard (AES-256-GCM). Must be a 32-byte hex string, e.g. generate
# with: openssl rand -hex 32
# If you already ran supabase/schema.sql before this existed, also run
# supabase/migrations/0001_add_access_code_encrypted.sql once.
ACCESS_CODE_ENCRYPTION_KEY=change-this-to-a-32-byte-hex-string

# There is no ADMIN_PASSWORD env var anymore - admin accounts live in the
# `admins` table (email + bcrypt password hash + role). Create the first one
# with: npm run create-admin -- "you@vecosoft.com" "a-strong-password"
