# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key - server-side only, NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage bucket used for candidate ZIP uploads (created by supabase/schema.sql)
SUPABASE_SUBMISSIONS_BUCKET=submissions

# Password for the /admin dashboard. Change this before deploying.
ADMIN_PASSWORD=change-me-now

# Used to sign the admin session cookie. Any long random string.
ADMIN_SESSION_SECRET=change-this-to-a-long-random-string
